{
	"name": "@jx/git-resetter",
	"version": "1.0.0",
	"lock": false,
	"unstable": ["kv"],
	"exports": {
		"./main": "./main.ts"
	},
	"fmt": {
		"useTabs": true
	},
	"lint": {
		"rules": {
			"tags": ["recommended", "jsr"],
			"include": [
				"ban-untagged-todo",
				"camelcase",
				"default-param-last",
				"eqeqeq",
				"explicit-function-return-type",
				"explicit-module-boundary-types",
				"no-eval",
				"no-external-import",
				"no-inferrable-types",
				"no-non-null-asserted-optional-chain",
				"no-self-compare",
				"no-sync-fn-in-async-fn",
				"no-useless-rename",
				"triple-slash-reference"
			]
		}
	},
	"tasks": {},
	"imports": {
	}
}
